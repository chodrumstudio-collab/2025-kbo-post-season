# API Keys for Real Sports Data
# Copy this file to .env and add your actual API keys

# OpenAI API (for KBO chatbot - if you want to use it)
VITE_OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# YouTube API (for highlights)
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here

# News API (for baseball news)
VITE_NEWS_API_KEY=your_news_api_key_here

# Optional: Other sports APIs
VITE_ESPN_API_KEY=optional_espn_api_key
VITE_RAPID_API_KEY=optional_rapid_api_key
